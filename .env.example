# Opcional. Se estas variáveis não existirem, `npm start` gera as chaves
# em data/vapid.json e o token em data/send-token. Os dois arquivos estão
# no .gitignore. Não commite um .env com chave real.
#
# VAPID_SUBJECT é o claim `sub` do JWT (RFC 8292): um contato https: ou mailto:.
# Não é segredo. Troque pelo seu antes de usar isto fora do laboratório.
VAPID_SUBJECT=mailto:webpush-lab@luizschons.com

# Descomente só se você gerou o par com `npx web-push generate-vapid-keys`.
# A chave privada nunca vai para o navegador.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Protege o POST /send. Se vazio, o servidor gera um token e imprime no terminal.
# SEND_TOKEN=

# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=data
